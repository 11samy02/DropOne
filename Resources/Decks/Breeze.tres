[gd_resource type="Resource" script_class="DeckResource" format=3 uid="uid://breeze_deck_001"]

[ext_resource type="Script" uid="uid://c40nbsxolq1km" path="res://Scripts/Globals/DeckEntryResource.gd" id="1_breeze"]
[ext_resource type="Script" uid="uid://7ntgiiwhye0n" path="res://Scripts/Globals/DeckNumberRuleResource.gd" id="2_breeze"]
[ext_resource type="Script" uid="uid://52s8intselne" path="res://Scripts/Globals/DeckResource.gd" id="3_breeze"]

; SKIP x3 per color = 12
[sub_resource type="Resource" id="Resource_skip"]
script = ExtResource("1_breeze")
type = 2
count = 3
duplicate_for_all_colors = true

; REVERSE x3 per color = 12
[sub_resource type="Resource" id="Resource_reverse"]
script = ExtResource("1_breeze")
type = 0
count = 3
duplicate_for_all_colors = true

; DRAW+2 x2 per color = 8
[sub_resource type="Resource" id="Resource_draw2"]
script = ExtResource("1_breeze")
type = 3
value = 2
count = 2
duplicate_for_all_colors = true

; WILD x8
[sub_resource type="Resource" id="Resource_wild"]
script = ExtResource("1_breeze")
color = 4
type = 4
count = 8

; WILD DRAW+2 x4  (mild punishment wild)
[sub_resource type="Resource" id="Resource_wilddraw2"]
script = ExtResource("1_breeze")
color = 4
type = 5
value = 2
count = 4

; Number rules: 0–8, 2 copies default, 0 → 1 copy
; Total numbers: 4 + (8 numbers * 2 * 4 colors) = 68
[sub_resource type="Resource" id="Resource_numrules"]
script = ExtResource("2_breeze")
min_number = 0
max_number = 8
default_copies = 2
overrides = {"0": 1}

[resource]
script = ExtResource("3_breeze")
deck_name = "Breeze"
number_rules = SubResource("Resource_numrules")
entries = Array[ExtResource("1_breeze")]([SubResource("Resource_skip"), SubResource("Resource_reverse"), SubResource("Resource_draw2"), SubResource("Resource_wild"), SubResource("Resource_wilddraw2")])
max_card_lose_enabled = false
max_card_lose_count = 20
