[resource]
script = ExtResource("3_chaos")
deck_name = "Chaos"
number_rules = SubResource("Resource_numrules")
entries = Array[ExtResource("1_chaos")]([SubResource("Resource_skip"), SubResource("Resource_reverse"), SubResource("Resource_draw2"), SubResource("Resource_draw4col"), SubResource("Resource_swap"), SubResource("Resource_wild"), SubResource("Resource_wild4"), SubResource("Resource_wild6")])
