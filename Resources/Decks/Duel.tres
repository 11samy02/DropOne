type = 5
value = 4
count = 6

; Number rules: 0–9, 3 copies default, 0 → 1 copy
; Total numbers: 4 + (9 numbers * 3 * 4 colors) = 112
[sub_resource type="Resource" id="Resource_numrules"]
script = ExtResource("2_duel")
