max_number = 9
default_copies = 3
overrides = {"0": 1}

[resource]
script = ExtResource("3_duel")
deck_name = "Duel"
number_rules = SubResource("Resource_numrules")
entries = Array[ExtResource("1_duel")]([SubResource("Resource_skip"), SubResource("Resource_draw2"), SubResource("Resource_reverse"), SubResource("Resource_wild"), SubResource("Resource_wild4")])
